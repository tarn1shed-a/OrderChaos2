{
  "name": "haradon-multiplayer-prototype",
  "private": true,
  "description": "Local multiplayer browser prototype and read-only asset research tools; game resources are supplied separately.",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node --env-file-if-exists=../.env server.mjs",
    "test": "node --test test/*.test.mjs",
    "build:vercel": "node build-vercel.mjs",
    "check:vercel": "node build-vercel.mjs --check"
  },
  "dependencies": {
    "three": "0.187.0",
    "ws": "8.18.3"
  }
}
