# Copy this file to .env in the repository root. It is loaded by start.command
# and by `pnpm start` from prototype/. Do not commit the real .env.
HOST=0.0.0.0
PORT=8787

# Empty means browser connections must use the game server's own origin.
# For a separate frontend, list its exact HTTPS origins, separated by commas.
ALLOWED_ORIGINS=

# Optional absolute or repository-root-relative path for server-owned saves.
# Default: runtime/characters.json in the repository root (always ignored by Git).
# SAVE_FILE=/absolute/path/to/characters.json
